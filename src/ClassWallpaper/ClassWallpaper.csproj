<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ClassWallpaper</RootNamespace>
    <AssemblyName>ClassWallpaper</AssemblyName>
    <Version>0.1.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\ClassWallpaper.ico</ApplicationIcon>
    <!--
      发布单文件 exe（后续打包阶段执行）：
      dotnet publish -c Release -r win-x64 -p:PublishSelfContained=true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true
    -->
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ClassWallpaper.ico" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
