<UserControl x:Class="ClassWallpaper.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 设置表单卡片 -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                VerticalAlignment="Top"
                MaxWidth="720">
            <StackPanel>
                <!-- 日志保留天数 -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="日志保留天数"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding RetentionOptions}"
                              SelectedItem="{Binding LogRetentionDays}"
                              HorizontalAlignment="Left"
                              Width="120" />
                </Grid>

                <!-- 壁纸填充方式 -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="壁纸填充方式"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding WallpaperStyleOptions}"
                              SelectedItem="{Binding WallpaperStyle}"
                              HorizontalAlignment="Left"
                              Width="120" />
                    <TextBlock Grid.Column="1"
                               Text="（Fit=适应 / Stretch=拉伸 / Center=居中 / Tile=平铺）"
                               VerticalAlignment="Center"
                               Margin="130,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" />
                </Grid>

                <!-- 启动显示主窗口 -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="启动时显示主窗口"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding ShowMainWindowOnStartup}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="（取消勾选后启动直接后台托盘驻留）"
                               VerticalAlignment="Center"
                               Margin="30,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" />
                </Grid>

                <!-- 定时检查间隔 -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="换壁纸检查间隔"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding RotationIntervalHours}"
                              HorizontalAlignment="Left"
                              Width="120" />
                    <TextBlock Grid.Column="1"
                               Text="（小时；修改后重启应用生效）"
                               VerticalAlignment="Center"
                               Margin="130,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" />
                </Grid>

                <!-- 开机延迟检查 -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="开机延迟检查（秒）"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding StartupCheckDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Left"
                             Width="120"
                             VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="（开机后等待 N 秒再检查壁纸，0=立即；期间软件正常使用）"
                               VerticalAlignment="Center"
                               Margin="130,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" />
                </Grid>

                <!-- 壁纸目录 -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="壁纸目录"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding WallpapersDir, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="浏览..."
                            Command="{Binding BrowseWallpapersDirCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Padding="12,4" />
                </Grid>

                <!-- 数据目录（只读显示） -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="数据目录"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DataDir}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>

                <!-- 开机自启 -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="开机自启"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Button Grid.Column="1"
                            Content="{Binding AutoStartButtonText}"
                            Command="{Binding ToggleAutoStartCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            Padding="16,5" />
                </Grid>

                <!-- 保存 -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="保存设置"
                            Command="{Binding SaveCommand}"
                            Padding="20,7" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>

