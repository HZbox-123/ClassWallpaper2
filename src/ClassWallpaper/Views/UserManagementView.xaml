<UserControl x:Class="ClassWallpaper.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏：添加 + 导入 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="姓名：" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Text="排序："
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
            <TextBox Grid.Column="3"
                     Text="{Binding NewUserOrder, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="4"
                    Content="添加"
                    Command="{Binding AddCommand}"
                    Margin="8,0,0,0" />
            <Button Grid.Column="6"
                    Content="从 Excel 导入..."
                    Command="{Binding ImportExcelCommand}" />
        </Grid>

        <!-- 人员列表（支持多选：Ctrl/Shift 多选，批量删除）+ 操作按钮 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="UserList"
                      ItemsSource="{Binding Users}"
                      SelectionMode="Extended"
                      SelectionChanged="UserList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="排序"
                                        Width="70"
                                        DisplayMemberBinding="{Binding Order}" />
                        <GridViewColumn Header="姓名"
                                        Width="240"
                                        DisplayMemberBinding="{Binding Name}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Column="1" Margin="8,0,0,0" Width="76">
                <Button Content="上移"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding MoveUpCommand}"
                        Margin="0,0,0,6" />
                <Button Content="下移"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding MoveDownCommand}"
                        Margin="0,0,0,6" />
                <Button Content="删除"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding RemoveCommand}" />
            </StackPanel>
        </Grid>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   Foreground="{StaticResource TextMutedBrush}" />
    </Grid>
</UserControl>
