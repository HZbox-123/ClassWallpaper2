<UserControl x:Class="ClassWallpaper.Views.ScheduleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 参数卡片：星期勾选 + 起止日期 + 生成/保存 -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,10">
            <StackPanel>
                <!-- 星期几 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="排班星期："
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding WeekDayOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsChecked}"
                                          Margin="6,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 起止日期 + 按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="开始日期："
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <DatePicker SelectedDate="{Binding StartDate}" Width="130" />
                    <TextBlock Text="结束日期："
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <DatePicker SelectedDate="{Binding EndDate}" Width="130" />
                    <Button Content="生成计划"
                            Command="{Binding GenerateCommand}"
                            Margin="16,0,0,0" />
                    <Button Content="保存修改"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                </StackPanel>

                <!-- 节假日管理 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="节假日："
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <DatePicker SelectedDate="{Binding NewHoliday}" Width="130" />
                    <Button Content="添加"
                            Command="{Binding AddHolidayCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Padding="12,4" />
                    <ListBox ItemsSource="{Binding Holidays}"
                             SelectedItem="{Binding SelectedHoliday}"
                             MaxHeight="92"
                             Width="340"
                             Margin="8,0,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat={}{0:yyyy-MM-dd}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="删除选中"
                            Command="{Binding RemoveHolidayCommand}"
                            Style="{StaticResource DangerButton}"
                            Margin="8,0,0,0"
                            Padding="12,4" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 计划列表（区间展示：开始日期 ~ 结束日期 + 人员，支持直接编辑） -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="开始日期" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="结束日期" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EndDateOrDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="星期" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding WeekdayText}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="人员姓名"
                                    Width="200"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
